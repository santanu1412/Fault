# Database
POSTGRES_USER=fault_user
POSTGRES_PASSWORD=fault_pass_dev
POSTGRES_DB=fault_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fault_user:fault_pass_dev@db:5432/fault_db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# Seed configuration
SEED_SUBSTATIONS=4
SEED_FEEDERS_PER_SUB=3
SEED_DTS_PER_FEEDER=8
SEED_POLES_PER_DT_MIN=15
SEED_POLES_PER_DT_MAX=60
SEED_KNOWN_TOPOLOGY_PCT=0.40
SEED_DEVICE_COVERAGE_PCT=0.91
SEED_MISSING_PINCODE_PCT=0.03

# Localization engine
POLL_INTERVAL_SECONDS=3
HEARTBEAT_TIMEOUT_MINUTES=16
DEBOUNCE_MISSED_HEARTBEATS=2
OUTAGE_BUFFER_MINUTES=15

# AI / LLM (optional — system works without this)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
AI_TIMEOUT_SECONDS=3

# Frontend
VITE_API_URL=http://localhost:8000
VITE_POLL_INTERVAL_MS=3000
